# ---- 本地运行时产物，绝不入库 ----
# 注意：.gitignore 不支持行内注释，注释必须单独成行
config.json
data/*.db
data/*.db-*
data/*.init.lock
logs/
media_gateway/logs/
media_gateway/tts_output/
media_gateway/uploads/
core/console/_mock/screenshots/
core/console/_mock/*.json
core/console/_mock/evidence-http.txt

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# ---- 临时 ----
*.tmp
*.log

# ---- 工具运行产物 ----
data/sqlite_backup_state.json
.promptfoo/
tests/promptfoo/.promptfoo/
phoenix_data/
config.json.bak
config.json.bak-*

# P0.3 任务库与本地备份
media_gateway/data/
media_gateway/*.bak*

# 探针运行时数据
ops/probe/state.db
ops/probe/state.db-*

mobius/

# 阶段0 数据/密钥（不入库）
.env
*.env
pgbackup/

# 网关运行时锁文件
media_gateway/.gateway.lock

# 启动器构建产物
launcher/dist/
launcher/build/
launcher/*.spec

# 安装包构建产物
installer/dist/
installer/*.log

# L3 发布产物
release/

# 密钥 SSOT（仅本地）
secrets.json
**/secrets.json
!ops/secrets/secrets.example.json
backups/security/

# 隐私画像（本地留存，仅移出仓库跟踪）
config/account_profiles.json

# 通用开发/测试缓存
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# 本机备份（含安全备份）
backups/

# Studio 构建产物（子目录也有规则，这里显式声明）
web/studio/dist/
