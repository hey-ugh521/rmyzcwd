# Möbius Studio 环境变量样例（复制为 .env.local，勿入库）
# ---------------------------------------------------------------------------
# API 模式：mock | live | auto
#   mock = 纯前端内置模拟后端（默认演示，无需本机 Core/Gateway）
#   live = 直连本机 Core/Gateway
#   auto = 先探活 Core /health，不可达则自动回退 mock（默认）
VITE_API_MODE=auto

# 生产/联调 base（留空 = 同源；开发期由 vite proxy 的 /__core /__gw 前缀代理）
# 例：直连本机后端时填写 http://127.0.0.1:8900 / http://127.0.0.1:8899
VITE_CORE_BASE=
VITE_GATEWAY_BASE=

# 变更类接口鉴权（M3a 目标）。二选一：
#   1) 在此注入 Bearer token（仅开发，.env.local 不入库）
#   2) 先打开 /console 取得同源 HttpOnly cookie，前端自动带上
# 切勿把 token 写进源码 / localStorage / URL。
VITE_CORE_TOKEN=

# 轮询节奏（毫秒）：运行中任务 / 空闲
VITE_POLL_RUNNING_MS=3500
VITE_POLL_IDLE_MS=18000