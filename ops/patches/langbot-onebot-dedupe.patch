+"""OneBot 事件级 message_id 去重（本地补丁文件之一）。
+
+目的：NapCat/OneBot 在重连、重试或重放时可能把同一条消息事件投递多次，
+导致重复回复/重复出图。此模块在适配器入口按 message_id 做 TTL+LRU 去重。
+
+环境变量：
+  MOBIUS_ONEBOT_DEDUPE_TTL   去重窗口秒数（0 关闭，默认 600）
+  MOBIUS_ONEBOT_DEDUPE_MAX   缓存条目上限（默认 2048）
+
+注意：进程内缓存，重启后清空；对短时间重放足够。
+"""
+
+from __future__ import annotations
+
+import os
+import time
+from collections import OrderedDict
+
+
+class MessageDedupe:
+    def __init__(self, ttl: float = 600.0, max_size: int = 2048, clock=None) -> None:
+        self.ttl = float(ttl)
+        self.max_size = max(1, int(max_size))
+        self._clock = clock or time.monotonic
+        self._seen: "OrderedDict[str, float]" = OrderedDict()
+
+    @classmethod
+    def from_env(cls) -> "MessageDedupe":
+        try:
+            ttl = float(os.environ.get("MOBIUS_ONEBOT_DEDUPE_TTL", "600") or 0)
+        except ValueError:
+            ttl = 600.0
+        try:
+            max_size = int(os.environ.get("MOBIUS_ONEBOT_DEDUPE_MAX", "2048") or 2048)
+        except ValueError:
+            max_size = 2048
+        return cls(ttl=ttl, max_size=max_size)
+
+    @property
+    def enabled(self) -> bool:
+        return self.ttl > 0
+
+    def _prune(self, now: float) -> None:
+        if not self._seen:
+            return
+        cutoff = now - self.ttl
+        while self._seen:
+            key, ts = next(iter(self._seen.items()))
+            if ts >= cutoff:
+                break
+            self._seen.popitem(last=False)
+        while len(self._seen) > self.max_size:
+            self._seen.popitem(last=False)
+
+    def is_duplicate(self, key: str) -> bool:
+        """返回 True 表示窗口内已见过（重复），False 表示首次或已过期。"""
+        if not self.enabled or not key:
+            return False
+        now = self._clock()
+        self._prune(now)
+        if key in self._seen:
+            self._seen.move_to_end(key)
+            return True
+        self._seen[key] = now
+        while len(self._seen) > self.max_size:
+            self._seen.popitem(last=False)
+        return False
+
+    def stats(self) -> dict:
+        return {"ttl": self.ttl, "max_size": self.max_size, "size": len(self._seen), "enabled": self.enabled}
